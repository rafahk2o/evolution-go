{
  "manifest_version": 3,
  "name": "Evolution GO WACalls",
  "version": "0.2.0",
  "description": "Chamadas de voz WhatsApp com gravação local pela Evolution GO.",
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Abrir Evolution GO WACalls"
  }
}
